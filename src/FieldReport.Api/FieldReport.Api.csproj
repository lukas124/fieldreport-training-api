<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- net9.0: docelowy host (FreeBSD) ma tylko runtime 8/9 -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FieldReport.Api</RootNamespace>
    <AssemblyName>FieldReport.Api</AssemblyName>
    <Version>1.0.2</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- brak komentarza XML w publicznym typie to nie błąd -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>fieldreport-api-szkolenie</UserSecretsId>
    <!-- artefakt przenośny (framework-dependent, bez RID): uruchamiany przez `dotnet FieldReport.Api.dll`,
         więc bez natywnego launchera platformy budującej (macOS/Linux) — na FreeBSD i tak by nie działał -->
    <UseAppHost>false</UseAppHost>
    <!-- mały proces na współdzielonym hoście -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FirebaseAdmin" Version="3.7.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.20" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- lokalne dane i skrypty nie trafiają do publikacji -->
    <Content Remove="data/**" />
    <None Remove="data/**" />
    <!-- ustawienia deweloperskie (m.in. dev-admin-key) nie trafiają na serwer -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FieldReport.Api.Tests" />
  </ItemGroup>

</Project>

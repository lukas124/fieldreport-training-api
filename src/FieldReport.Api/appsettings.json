{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PathBase": "",
  "Hosting": {
    "Port": 5080,
    "ListenOnAllInterfaces": false
  },
  "Auth": {
    "Pin": "1234",
    "AccessTokenLifetimeSeconds": 600,
    "RefreshTokenLifetimeDays": 30,
    "SigningKey": ""
  },
  "Storage": {
    "DataDirectory": "data",
    "MaxPhotoBytes": 5242880,
    "MaxReportsPerTechnician": 500,
    "MaxDevicesPerTechnician": 10
  },
  "Firebase": {
    "CredentialsPath": "",
    "Disabled": false
  },
  "Admin": {
    "Key": ""
  },
  "Dispatcher": {
    "Key": ""
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitsPerMinute": 300,
    "AuthPermitsPerMinute": 30,
    "DispatcherPermitsPerMinute": 60
  },
  "ReverseProxy": {
    "TrustAllProxies": true,
    "UseForwardedPrefix": true
  },
  "Swagger": {
    "Enabled": true
  }
}

# Konfiguracja FieldReport API na MyDevil — kopia robocza: ~/apps/fieldreport-api/fieldreport-api.env (chmod 600).
# Tworzy ją setup-mydevil.sh (podstawia __PORT__, __HOME__, __ADMIN_KEY__). Plik NIE jest nadpisywany przy deployu.
# Format: KLUCZ=wartość (bez spacji i cudzysłowów) — plik jest wczytywany przez run.sh (sh, set -a).
# Klucze konfiguracji ASP.NET: sekcja:klucz → sekcja__klucz.

ASPNETCORE_ENVIRONMENT=Production
# port zarezerwowany przez `devil port add tcp random fieldreport-api`; proxy www → localhost:<port>
ASPNETCORE_URLS=http://127.0.0.1:__PORT__
PathBase=/maui/podstawowe
# żądania spoza PathBase (np. https://mobilny.dev/) → 301 na ten adres
RedirectOutsidePathBase=https://strefakodera.pl/szkolenia

# PostgreSQL z MyDevil (devil pgsql db add fieldreport) — uzupełnij hasło
ConnectionStrings__FieldReport=Host=pgsql88.mydevil.net;Database=p1028_fieldrepor;Username=p1028_fieldrepor;Password=__PGSQL_PASSWORD__

# katalog na zdjęcia zgłoszeń i klucz podpisu JWT
Storage__DataDirectory=__HOME__/apps/fieldreport-api/data
# klucz do POST /api/admin/reset (nagłówek X-Admin-Key) — losowy, generowany przy setupie
Admin__Key=__ADMIN_KEY__
# opcjonalnie: klucz wymagany od dyspozytora (nagłówek X-Dispatcher-Key); pusty = otwarte (szkolenie)
Dispatcher__Key=

# Push (FCM). API działa bez tego pliku — wtedy health: firebaseConfigured=false, push „pominięto”.
# Wgraj klucz konta serwisowego do secrets/ (chmod 600) i zrób `run.sh restart`.
GOOGLE_APPLICATION_CREDENTIALS=__HOME__/apps/fieldreport-api/secrets/firebase-sa.json

# Access token 10 min (na demo odświeżania po 401 można dać 60)
Auth__AccessTokenLifetimeSeconds=600

# .NET na współdzielonym hoście: mało pamięci, bez telemetrii
DOTNET_gcServer=0
DOTNET_GCHeapHardLimit=0x10000000
DOTNET_CLI_TELEMETRY_OPTOUT=1
DOTNET_NOLOGO=1

# Limity na adres IP — cała sala szkoleniowa zwykle wychodzi przez jeden NAT, więc wyżej niż domyślne 300/30/60
RateLimiting__PermitsPerMinute=2000
RateLimiting__AuthPermitsPerMinute=200
RateLimiting__DispatcherPermitsPerMinute=120
